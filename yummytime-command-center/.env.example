# Copy this file to .env and fill in values. NEVER commit .env.

# --- Server ---
PORT=4000
# Where SQLite DB, recordings and snapshots are stored (relative to project root)
DATA_DIR=./data
# Public base URL used in WhatsApp live-view links (e.g. your LAN IP or tunnel URL)
PUBLIC_BASE_URL=http://localhost:5173
# Set to true to run with mock devices only (no real API calls)
MOCK_MODE=true
TZ=Europe/Oslo

# --- Location ---
LOCATION_NAME=Yummy Time Capsule

# --- IMOU Open API (data center fk = Central Europe) ---
IMOU_APP_ID=
IMOU_APP_SECRET=
IMOU_DATA_CENTER=fk

# --- Aqara Open API (EU) - use APPROVED "DEMO APPLICATION" project only (pending = error 2046) ---
AQARA_APP_ID=
AQARA_KEY_ID=
AQARA_APP_KEY=
AQARA_REGION=eu
# Aqara account used to obtain access token (filled during step 5)
AQARA_ACCOUNT=

# --- Twilio (voice calls + WhatsApp) ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
# e.g. whatsapp:+14155238886
WHATSAPP_FROM=
