# Copy this file to .env and fill in values. NEVER commit .env.

# --- Server ---
PORT=4000
# Where SQLite DB, recordings and snapshots are stored (relative to project root)
DATA_DIR=./data
# Public address of this app: used for the live-view link in alarm messages, and (when https +
# public) for Twilio to report "press 1" / WhatsApp "OK" acknowledgements back to the app
PUBLIC_BASE_URL=http://localhost:5173
# Password for the dashboard (browser login prompt). Set it before the app is reachable outside your LAN.
APP_PASSWORD=
# Set to true to run with mock devices only (no real API calls)
MOCK_MODE=true
TZ=Europe/Oslo

# --- Location ---
LOCATION_NAME=Yummy Time Capsule

# --- IMOU Open API (data center fk = Central Europe) ---
IMOU_APP_ID=
IMOU_APP_SECRET=
IMOU_DATA_CENTER=fk
# Status check every N seconds, snapshot tiles every N minutes (snapshots only while a dashboard is open)
IMOU_STATUS_POLL_SEC=60
SNAPSHOT_INTERVAL_MIN=5
# Testing only: point at the fake IMOU server (npm run fake:imou -w server)
# IMOU_API_URL=http://localhost:4555/openapi

# --- Camera recording (MP4 in data/recordings) ---
# Optional full path to ffmpeg; otherwise ffmpeg on PATH, otherwise the bundled one
FFMPEG_PATH=
RECORDING_RETENTION_DAYS=14

# --- Aqara Open API (EU) - use APPROVED "DEMO APPLICATION" project only (pending = error 2046) ---
AQARA_APP_ID=
AQARA_KEY_ID=
AQARA_APP_KEY=
AQARA_REGION=eu
# Optional: pre-fills the account field on Devices → Aqara account
AQARA_ACCOUNT=
# How often devices are read (seconds). Lower = faster alarms, more API calls
AQARA_POLL_SEC=20
AQARA_TOKEN_VALIDITY=7d
# Testing only: fake Aqara server (npm run fake:aqara -w server)
# AQARA_API_URL=http://localhost:4556

# --- Twilio (voice calls + WhatsApp) ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
# e.g. whatsapp:+14155238886
WHATSAPP_FROM=
# Approved WhatsApp template (Content SID, HX...) with {{1}} = title and {{2}} = details + link.
# Without it WhatsApp only delivers to people who messaged your number in the last 24 h.
WHATSAPP_CONTENT_SID=
# Voice for the spoken alarm message
ALERT_VOICE=Polly.Amy
ALERT_VOICE_LANGUAGE=en-GB
